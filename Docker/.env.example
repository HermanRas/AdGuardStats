# Copy to .env (chmod 600). Never commit .env. See Plan.md section 8.
ADGUARD_URL=http://adguardhome:80
ADGUARD_USER=stats
ADGUARD_PASS=
TZ=Africa/Johannesburg
RETENTION_DAYS=180
# Your own domains (comma-separated); they and their subdomains count as Infrastructure.
LOCAL_DOMAINS=

# Optional Cloudflare Intel lookups for domains the lists miss. Token permission: Account > Intel > Read.
CF_ENABLED=0
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_BATCH=100
CF_RECHECK_DAYS=90

# Optional second auth layer behind NPM: user:bcrypt-hash (Phase 9).
APP_BASIC_AUTH=
